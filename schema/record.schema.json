{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spektran.github.io/spektran/schema/record.schema.json",
  "title": "SPEKTRAN spectral record",
  "description": "Metadata schema (v0.1 draft) for a single SPEKTRAN spectral record. Signal arrays live in HDF5/Parquet; this JSON document describes them. All physical quantities embed their unit in the field name (e.g. _ppm, _K, _cm1). DRAFT: v0.1 is finalized only after Gate G2 (literature-anchored field-coverage check).",
  "type": "object",
  "required": [
    "record_id",
    "schema_version",
    "data_origin",
    "technique",
    "signals",
    "labels",
    "conditions",
    "instrument"
  ],
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUIDv4 uniquely identifying this record."
    },
    "schema_version": {
      "enum": [
        "0.1",
        "0.2"
      ],
      "description": "Version of this schema the record conforms to."
    },
    "data_origin": {
      "enum": [
        "simulated",
        "experimental",
        "augmented"
      ],
      "description": "Provenance class. All official SPEKTRAN releases are 'simulated'. 'experimental' and 'augmented' are reserved for future external contributions."
    },
    "technique": {
      "enum": [
        "TDLAS-DA",
        "TDLAS-WMS",
        "NDIR",
        "CRDS",
        "FTIR",
        "DOAS"
      ],
      "description": "Measurement technique."
    },
    "provenance": {
      "type": "object",
      "description": "Full reproducibility trace. Required when data_origin is 'simulated': same generator_version + random_seed + configs must reproduce the record bit-for-bit.",
      "required": [
        "generator_version",
        "random_seed",
        "instrument_config_id",
        "noise_config"
      ],
      "additionalProperties": false,
      "properties": {
        "generator_version": {
          "type": "string",
          "description": "Git tag or commit hash of the spektran generator that produced this record."
        },
        "hitran_data_version": {
          "type": "string",
          "description": "HITRAN edition / retrieval date of the line data used (e.g. 'HITRAN2020, fetched 2026-08-04')."
        },
        "random_seed": {
          "type": "integer",
          "minimum": 0,
          "description": "Seed of the per-record RNG stream."
        },
        "instrument_config_id": {
          "type": "string",
          "description": "Identifier of the virtual-instrument YAML config this record was sampled from."
        },
        "noise_config": {
          "type": "object",
          "description": "The concrete noise/instrument parameter values sampled for THIS record (not the distributions). Keys mirror the instrument-config module names."
        }
      }
    },
    "signals": {
      "type": "object",
      "description": "Descriptors of the signal arrays stored in the data file. At least one signal must be present.",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "raw_scan": {
          "type": "object",
          "description": "Raw detector signal over one laser scan (time domain).",
          "required": [
            "array_ref",
            "n_samples",
            "sampling_rate_Hz"
          ],
          "additionalProperties": false,
          "properties": {
            "array_ref": {
              "$ref": "#/$defs/array_ref"
            },
            "n_samples": {
              "type": "integer",
              "minimum": 2
            },
            "sampling_rate_Hz": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "absorbance": {
          "type": "object",
          "description": "Direct-absorption absorbance spectrum on a wavenumber axis.",
          "required": [
            "array_ref",
            "n_samples",
            "wavenumber_axis"
          ],
          "additionalProperties": false,
          "properties": {
            "array_ref": {
              "$ref": "#/$defs/array_ref"
            },
            "n_samples": {
              "type": "integer",
              "minimum": 2
            },
            "wavenumber_axis": {
              "$ref": "#/$defs/wavenumber_axis"
            }
          }
        },
        "demod_1f": {
          "$ref": "#/$defs/demod_signal"
        },
        "demod_2f": {
          "$ref": "#/$defs/demod_signal"
        },
        "demod_3f": {
          "$ref": "#/$defs/demod_signal"
        },
        "demod_4f": {
          "$ref": "#/$defs/demod_signal"
        },
        "ratio_2f1f": {
          "type": "object",
          "description": "Calibration-free WMS 2f/1f ratio (R_2f / R_1f). Self-normalizing against laser intensity variations (Rieker et al. 2009, doi:10.1364/AO.48.005546).",
          "required": [
            "array_ref",
            "n_samples"
          ],
          "additionalProperties": false,
          "properties": {
            "array_ref": {
              "$ref": "#/$defs/array_ref"
            },
            "n_samples": {
              "type": "integer",
              "minimum": 2
            }
          }
        },
        "active_channel": {
          "type": "object",
          "description": "NDIR active channel detector signal (scalar).",
          "required": [
            "array_ref",
            "n_samples"
          ],
          "additionalProperties": false,
          "properties": {
            "array_ref": {
              "$ref": "#/$defs/array_ref"
            },
            "n_samples": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "reference_channel": {
          "type": "object",
          "description": "NDIR reference channel detector signal (scalar).",
          "required": [
            "array_ref",
            "n_samples"
          ],
          "additionalProperties": false,
          "properties": {
            "array_ref": {
              "$ref": "#/$defs/array_ref"
            },
            "n_samples": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "ratio": {
          "type": "object",
          "description": "NDIR active/reference ratio (scalar).",
          "required": [
            "array_ref",
            "n_samples"
          ],
          "additionalProperties": false,
          "properties": {
            "array_ref": {
              "$ref": "#/$defs/array_ref"
            },
            "n_samples": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "tau_spectrum": {
          "type": "object",
          "description": "Ring-down time spectrum across wavenumber scan (CRDS).",
          "required": [
            "array_ref",
            "n_samples"
          ],
          "additionalProperties": false,
          "properties": {
            "array_ref": {
              "type": "string"
            },
            "n_samples": {
              "type": "integer",
              "minimum": 1
            },
            "unit": {
              "type": "string"
            }
          }
        },
        "alpha_spectrum": {
          "type": "object",
          "description": "Absorption coefficient spectrum derived from ring-down times (CRDS).",
          "required": [
            "array_ref",
            "n_samples"
          ],
          "additionalProperties": false,
          "properties": {
            "array_ref": {
              "type": "string"
            },
            "n_samples": {
              "type": "integer",
              "minimum": 1
            },
            "unit": {
              "type": "string"
            }
          }
        },
        "ftir_spectrum": {
          "type": "object",
          "description": "FTIR recovered spectrum after apodized FFT (wavenumber domain).",
          "required": [
            "array_ref",
            "n_samples",
            "unit"
          ],
          "additionalProperties": false,
          "properties": {
            "array_ref": {
              "$ref": "#/$defs/array_ref"
            },
            "n_samples": {
              "type": "integer",
              "minimum": 2
            },
            "unit": {
              "type": "string"
            }
          }
        },
        "doas_spectrum": {
          "type": "object",
          "description": "DOAS differential optical density after polynomial high-pass filtering.",
          "required": [
            "array_ref",
            "n_samples",
            "unit"
          ],
          "additionalProperties": false,
          "properties": {
            "array_ref": {
              "$ref": "#/$defs/array_ref"
            },
            "n_samples": {
              "type": "integer",
              "minimum": 2
            },
            "unit": {
              "type": "string"
            }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "required": [
        "species"
      ],
      "additionalProperties": false,
      "properties": {
        "species": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "molecule",
              "hitran_molecule_id",
              "concentration_ppm"
            ],
            "additionalProperties": false,
            "properties": {
              "molecule": {
                "type": "string",
                "description": "Chemical formula, e.g. 'CH4'."
              },
              "hitran_molecule_id": {
                "type": "integer",
                "minimum": 1,
                "description": "HITRAN molecule number (CH4 = 6, CO2 = 2)."
              },
              "concentration_ppm": {
                "type": "number",
                "minimum": 0,
                "description": "Mole fraction in parts-per-million (ppmv)."
              },
              "concentration_uncertainty_ppm": {
                "type": "number",
                "minimum": 0,
                "description": "1-sigma uncertainty. For simulated data this is 0 unless label noise was deliberately injected."
              }
            }
          }
        },
        "ood_label": {
          "enum": [
            0,
            1
          ],
          "description": "Out-of-distribution flag for the T6 instrument-detection task: 0 = in-distribution instrument, 1 = held-out/out-of-distribution instrument. Present only on T6 dataset records."
        }
      }
    },
    "conditions": {
      "type": "object",
      "required": [
        "temperature_K",
        "pressure_atm",
        "path_length_m",
        "matrix_gas"
      ],
      "additionalProperties": false,
      "properties": {
        "temperature_K": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pressure_atm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "path_length_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "matrix_gas": {
          "type": "string",
          "description": "Bulk/bath gas, e.g. 'N2' or 'air'."
        },
        "sample_flow_L_per_min": {
          "type": "number",
          "minimum": 0,
          "description": "Sample gas flow rate through the cell (0 = static fill)."
        },
        "sample_conditioning": {
          "type": "string",
          "description": "Upstream sample handling: filtering, drying, pressure regulation, heated lines. Free text."
        },
        "interferents": {
          "type": "array",
          "description": "Interfering absorbers present in addition to the labeled target species.",
          "items": {
            "type": "object",
            "required": [
              "molecule",
              "hitran_molecule_id",
              "concentration_ppm"
            ],
            "additionalProperties": false,
            "properties": {
              "molecule": {
                "type": "string"
              },
              "hitran_molecule_id": {
                "type": "integer",
                "minimum": 1
              },
              "concentration_ppm": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "processing": {
      "type": "object",
      "description": "Signal-processing and calibration methodology. Optional; primarily for experimental/augmented records where the raw-to-reported chain must be reproducible. For simulated records the generator config plays this role.",
      "additionalProperties": false,
      "properties": {
        "calibration_method": {
          "type": "string",
          "description": "e.g. 'calibration-free (first-principles)', 'reference-gas calibration'."
        },
        "calibration_reference": {
          "type": "string",
          "description": "Certified gas standard / reference instrument used, with stated uncertainty."
        },
        "baseline_treatment": {
          "type": "string",
          "description": "Zero-absorption baseline determination (polynomial fit, I0 reference, baseline-free scheme)."
        },
        "wavelength_calibration_method": {
          "type": "string",
          "description": "Frequency-axis calibration: etalon FSR, wavemeter, reference cell."
        },
        "spectral_fitting_method": {
          "type": "string",
          "description": "Fit procedure converting spectra to gas properties."
        },
        "line_shape_model": {
          "type": "string",
          "description": "Profile used in simulation/fitting: 'Voigt', 'Rautian', 'HTP', ..."
        },
        "demodulation_method": {
          "type": "string",
          "description": "Lock-in implementation (analog / digital / FPGA software lock-in)."
        },
        "denoising_method": {
          "type": "string",
          "description": "Additional digital denoising applied (wavelet, EMD, Kalman, ML)."
        },
        "averaging_n_scans": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of averaged scans per reported spectrum."
        },
        "averaging_time_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Integration/averaging time per reported data point."
        },
        "uncertainty_budget_note": {
          "type": "string",
          "description": "Itemized combined-uncertainty budget or pointer to it."
        }
      }
    },
    "measurement": {
      "type": "object",
      "description": "Metadata for experimental (measured) records. Optional; primarily for data_origin: experimental/augmented.",
      "additionalProperties": false,
      "properties": {
        "operator": {
          "type": "string",
          "description": "Person or team who performed the measurement."
        },
        "date_utc": {
          "type": "string",
          "format": "date-time",
          "description": "Measurement timestamp (ISO 8601)."
        },
        "facility": {
          "type": "string",
          "description": "Laboratory or field site."
        },
        "instrument_serial": {
          "type": "string",
          "description": "Serial number of the physical instrument."
        },
        "notes": {
          "type": "string",
          "description": "Free-text notes about the measurement."
        }
      }
    },
    "instrument": {
      "type": "object",
      "required": [
        "target_lines"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "object",
          "description": "Broadband IR source (NDIR).",
          "additionalProperties": false,
          "properties": {
            "temperature_K": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "filters": {
          "type": "object",
          "description": "NDIR bandpass filter configuration.",
          "additionalProperties": false,
          "properties": {
            "active_center_cm1": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "active_fwhm_cm1": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "reference_center_cm1": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "reference_fwhm_cm1": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "shape": {
              "enum": [
                "gaussian",
                "tophat"
              ]
            }
          }
        },
        "laser": {
          "type": "object",
          "required": [
            "center_wavenumber_cm1",
            "scan_range_cm1"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "description": "Laser source class, e.g. 'DFB', 'VCSEL', 'QCL', 'ICL', 'ECDL'."
            },
            "center_wavenumber_cm1": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "scan_range_cm1": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Total scanned optical frequency range."
            },
            "scan_rate_Hz": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Scan (ramp) repetition rate."
            },
            "scan_waveform": {
              "enum": [
                "sawtooth",
                "triangle",
                "sine"
              ],
              "description": "Shape of the scan drive waveform."
            },
            "linewidth_MHz": {
              "type": "number",
              "minimum": 0,
              "description": "Laser Lorentzian linewidth (FWHM). 0 = ideal monochromatic."
            },
            "operating_temperature_K": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Laser temperature setpoint reaching the target line."
            },
            "injection_current_mA": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Mean injection current at the operating point."
            },
            "output_power_mW": {
              "type": "number",
              "minimum": 0,
              "description": "Optical output power at the operating point."
            },
            "tuning_poly_cm1": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "Polynomial coefficients (ascending order, cm-1 per unit normalized ramp) of the current-to-optical-frequency tuning response used to build the frequency axis."
            }
          }
        },
        "modulation": {
          "type": "object",
          "description": "Wavelength-modulation parameters. Required when technique is TDLAS-WMS.",
          "required": [
            "frequency_Hz",
            "depth_cm1"
          ],
          "additionalProperties": false,
          "properties": {
            "frequency_Hz": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "depth_cm1": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Optical-frequency modulation amplitude a in nu(t) = nu_c + a*cos(2*pi*f*t)."
            },
            "phase_rad": {
              "type": "number"
            },
            "harmonic_scheme": {
              "enum": [
                "1f",
                "2f",
                "2f/1f",
                "3f",
                "4f",
                "other"
              ],
              "description": "Harmonic detection / normalization scheme."
            },
            "modulation_index": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "m = depth / line HWHM at the measurement condition (2f optimum ~2.2)."
            },
            "im_i0_rel": {
              "type": "number",
              "description": "Linear intensity-modulation amplitude i0 (relative), calibration-free WMS characterization (Rieker/Hanson convention)."
            },
            "im_i2_rel": {
              "type": "number",
              "description": "Nonlinear intensity-modulation amplitude i2 (relative)."
            },
            "fm_im_phase1_rad": {
              "type": "number",
              "description": "Phase shift psi1 between FM and linear IM."
            },
            "fm_im_phase2_rad": {
              "type": "number",
              "description": "Phase shift psi2 between FM and nonlinear IM."
            }
          }
        },
        "cell": {
          "type": "object",
          "description": "Absorption cell / optical geometry.",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "description": "e.g. 'Herriott multipass', 'White', 'single-pass extractive', 'open path', 'in situ line-of-sight'."
            },
            "number_of_passes": {
              "type": "integer",
              "minimum": 1
            },
            "volume_cm3": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "temperature_control": {
              "type": "string",
              "description": "Thermal stabilization / insulation arrangement, free text."
            }
          }
        },
        "detector": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "description": "e.g. 'InGaAs photodiode'."
            },
            "bandwidth_Hz": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "target_lines": {
          "type": "array",
          "minItems": 1,
          "description": "HITRAN transitions targeted by this measurement.",
          "items": {
            "type": "object",
            "required": [
              "hitran_molecule_id",
              "wavenumber_cm1"
            ],
            "additionalProperties": false,
            "properties": {
              "hitran_molecule_id": {
                "type": "integer",
                "minimum": 1
              },
              "isotopologue_id": {
                "type": "integer",
                "minimum": 1
              },
              "wavenumber_cm1": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "line_strength_cm_per_molec": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Line intensity S(296 K) [cm-1/(molecule cm-2)] snapshot from the pinned database version."
              },
              "elower_cm1": {
                "type": "number",
                "minimum": 0,
                "description": "Lower-state energy E''."
              },
              "gamma_air_cm1_per_atm": {
                "type": "number",
                "minimum": 0
              },
              "gamma_self_cm1_per_atm": {
                "type": "number",
                "minimum": 0
              },
              "n_air": {
                "type": "number",
                "description": "Temperature exponent of gamma_air (dimensionless)."
              },
              "delta_air_cm1_per_atm": {
                "type": "number",
                "description": "Air pressure-induced line shift coefficient."
              }
            }
          }
        },
        "cavity": {
          "type": "object",
          "description": "Optical cavity parameters (CRDS).",
          "additionalProperties": false,
          "properties": {
            "length_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "mirror_reflectivity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "finesse": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "tau0_s": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "spectrometer": {
          "type": "object",
          "description": "FTIR spectrometer parameters (resolution, apodization).",
          "properties": {
            "max_opd_cm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "resolution_cm1": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "apodization": {
              "type": "string"
            }
          }
        },
        "spectrograph": {
          "type": "object",
          "description": "DOAS spectrograph parameters.",
          "properties": {
            "poly_order": {
              "type": "integer",
              "minimum": 1
            },
            "mie_tau_ref": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "data_origin": {
            "const": "simulated"
          }
        }
      },
      "then": {
        "required": [
          "provenance"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "technique": {
            "const": "TDLAS-WMS"
          }
        }
      },
      "then": {
        "properties": {
          "instrument": {
            "required": [
              "laser",
              "detector",
              "target_lines",
              "modulation"
            ]
          },
          "signals": {
            "anyOf": [
              {
                "required": [
                  "demod_1f"
                ]
              },
              {
                "required": [
                  "demod_2f"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "technique": {
            "const": "TDLAS-DA"
          }
        }
      },
      "then": {
        "properties": {
          "instrument": {
            "required": [
              "laser",
              "detector",
              "target_lines"
            ]
          },
          "signals": {
            "anyOf": [
              {
                "required": [
                  "absorbance"
                ]
              },
              {
                "required": [
                  "raw_scan"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "technique": {
            "const": "NDIR"
          }
        }
      },
      "then": {
        "properties": {
          "signals": {
            "required": [
              "ratio"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "array_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Path of the array inside the container file, e.g. HDF5 dataset path '/records/<record_id>/absorbance' or Parquet column name."
    },
    "wavenumber_axis": {
      "type": "object",
      "description": "Uniform wavenumber axis: nu[i] = start_cm1 + i * step_cm1.",
      "required": [
        "start_cm1",
        "step_cm1"
      ],
      "additionalProperties": false,
      "properties": {
        "start_cm1": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "step_cm1": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "demod_signal": {
      "type": "object",
      "description": "Lock-in demodulated harmonic signal (WMS).",
      "required": [
        "array_ref",
        "n_samples"
      ],
      "additionalProperties": false,
      "properties": {
        "array_ref": {
          "$ref": "#/$defs/array_ref"
        },
        "n_samples": {
          "type": "integer",
          "minimum": 2
        },
        "lowpass_cutoff_Hz": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
